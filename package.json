{
  "name": "dsh-xiaoqi-pet",
  "version": "1.4.0",
  "private": false,
  "type": "module",
  "description": "Xiaoqi Desk Pet — a DSH companion with a real macOS desktop pet. Color-coded, bordered task cards, per-task drawers and task-name bubbles, with notices and click-to-open.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "desktop-pet",
    "macos",
    "session-monitor",
    "notifications"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "desktop/Sources/*.swift",
    "desktop/Resources/pet.svg",
    "desktop/Info.plist",
    "desktop/build.sh",
    "desktop/README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/white-source/dsh-xiaoqi-pet.git"
  },
  "homepage": "https://github.com/white-source/dsh-xiaoqi-pet#readme",
  "bugs": {
    "url": "https://github.com/white-source/dsh-xiaoqi-pet/issues"
  },
  "author": "white-source"
}
